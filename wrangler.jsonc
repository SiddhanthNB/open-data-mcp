{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ireland-open-data-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "persist": false
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.yml"],
      "fallthrough": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "f8fea1a1ecc8474d8cd6292f387ce406"
    }
  ],
  "ratelimits": [
    {
      "name": "MCP_USER_RATE_LIMITER",
      "namespace_id": "100101",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "MCP_GLOBAL_RATE_LIMITER",
      "namespace_id": "100102",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "OAUTH_RATE_LIMITER",
      "namespace_id": "100103",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
