UPSTASH_REDIS_REST_URL=replace-with-your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-redis-rest-token

# Required only when auth.mode is bearer.
OPEN_DATA_MCP_BEARER_TOKEN=replace-with-at-least-32-random-characters

# Required only when auth.mode is oauth.
OPEN_DATA_MCP_GITHUB_OAUTH_CLIENT_ID=replace-with-your-github-oauth-client-id
OPEN_DATA_MCP_GITHUB_OAUTH_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
